# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# pywal cache (regenerated by `wal -i ...`, don't need to track it)
.cache/
cache/

# local backups made by install.sh if run from inside this repo
.dotfiles-backup/

# secrets / machine-specific stuff — never commit these
*.env
.env.*
*_token
*_secret
*.key
*.pem
config/**/secrets*
config/**/*.local

# wallpapers can get large — uncomment if you don't want to version them
# wallpapers/*
# !wallpapers/.gitkeep

# fonts you're not allowed to redistribute (e.g. Segoe UI Variable) —
# add the specific filenames here so they never get committed by accident
# fonts/Segoe*

# compiled / generated artifacts some configs produce
*.o
*.pyc
__pycache__/
node_modules/
